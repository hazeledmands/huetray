<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>io.github.hazeledmands.huetray</string>
    <key>CFBundleName</key>
    <string>Hue Tray</string>
    <key>CFBundleDisplayName</key>
    <string>Hue Tray</string>
    <key>CFBundleExecutable</key>
    <string>HueTray</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- A menu bar app: no Dock icon and no menu of its own. -->
    <key>LSUIElement</key>
    <true/>
    <!-- The helper finds and talks to the bridge on the local network. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Hue Tray finds your Hue Bridge and controls your lights through it.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_hue._tcp</string>
    </array>
</dict>
</plist>
